[Unit]
Description=ML Sentinel FastAPI Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/ml-sentinel
ExecStart=/opt/ml-sentinel/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/ml-sentinel

[Install]
WantedBy=multi-user.target
